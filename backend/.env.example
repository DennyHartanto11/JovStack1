# ── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Comma-separated list of allowed CORS origins (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jovstack?schema=public

# Used by docker-compose to provision the Postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jovstack
DB_PORT=5432

# ── JWT / Auth ─────────────────────────────────────────────────
# PRODUCTION: generate unique random secrets (>=32 chars), e.g.:
#   openssl rand -base64 48
# The app refuses to boot in production with placeholder/short secrets.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d
# Token used to sign email-verification / password-reset tokens
JWT_ACTION_SECRET=change-me-action-secret

# ── Cookies ────────────────────────────────────────────────────
REFRESH_COOKIE_NAME=jov_rt
COOKIE_DOMAIN=localhost
# PRODUCTION: must be "true" (HTTPS-only refresh cookie) — enforced at boot.
COOKIE_SECURE=false

# ── Platform ───────────────────────────────────────────────────
# Root domain used to build {slug}.jovstack.app vanity URLs
PUBLIC_SITE_DOMAIN=jovstack.app
# Base URL where published sites are actually viewable (the /site renderer).
# Locally this is the backend; in prod point it at your real hosting.
PUBLIC_SITE_BASE_URL=http://localhost:4000/site
# Frontend base URL used to build verification / reset links in emails
APP_URL=http://localhost:3000

# ── SMTP / Email ───────────────────────────────────────────────
# Account-activation & password-reset emails are sent via this SMTP server.
# Local dev tip: run MailHog (docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog)
# and set SMTP_HOST=localhost SMTP_PORT=1025 SMTP_SECURE=false (no user/pass).
# In Docker Compose use SMTP_HOST=mailhog (the service name), not localhost.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Plaintext local SMTP (MailHog): skip STARTTLS and don't validate certs.
SMTP_IGNORE_TLS=true
SMTP_REJECT_UNAUTHORIZED=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=JovStack <no-reply@jovstack.app>

# ── Media ──────────────────────────────────────────────────────
MEDIA_MAX_SIZE_BYTES=5242880
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/static
